    <string name="title_seekbar_reconnect_grace">Atendotempo por rekonekto</string>
    <string name="summary_seekbar_reconnect_grace">Kiom longe KAST tenas la ludsesion dum perdita reto antaŭ ol fini ĝin. La gastiga komputilo ankaŭ havas propran limon.</string>
    <string name="title_seekbar_reconnect_retry">Intervalo inter rekonektaj provoj</string>
    <string name="summary_seekbar_reconnect_retry">La plej longa paŭzo inter la provoj de KAST restarigi la fluon post rompiĝo de la konekto.</string>
